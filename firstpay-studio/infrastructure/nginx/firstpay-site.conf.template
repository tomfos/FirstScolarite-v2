# FirstPay Studio — site nginx hôte (généré par setup-nginx-production.sh).
# Ne pas éditer sur le serveur : modifier le template puis relancer le script.
#
# Docker (127.0.0.1) :
#   frontend       → ${NGINX_FRONTEND_PORT}  (portail admin)
#   api-gateway    → ${NGINX_GATEWAY_PORT}  (API + /public/ direct)
#   payer-frontend → ${NGINX_PAYER_PORT}     (pages payeur /{shortCode}/{slug})

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream firstpay_frontend {
    server 127.0.0.1:${NGINX_FRONTEND_PORT};
    keepalive 16;
}

upstream firstpay_gateway {
    server 127.0.0.1:${NGINX_GATEWAY_PORT};
    keepalive 16;
}

upstream firstpay_payer {
    server 127.0.0.1:${NGINX_PAYER_PORT};
    keepalive 16;
}

# ── HTTP (Certbot ou accès direct) ───────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 (Certbot)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
    }

    location /webhooks/ {
        proxy_pass http://firstpay_gateway;
        include /etc/nginx/snippets/firstpay-proxy.conf;
        proxy_read_timeout 60s;
    }

    location /api/ {
        proxy_pass http://firstpay_gateway;
        include /etc/nginx/snippets/firstpay-proxy.conf;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # API publique (résolution directe gateway — secours si page payeur indisponible)
    location /public/ {
        proxy_pass http://firstpay_gateway;
        include /etc/nginx/snippets/firstpay-proxy.conf;
        proxy_buffering off;
    }

    location /swagger-ui {
        proxy_pass http://firstpay_gateway;
        include /etc/nginx/snippets/firstpay-proxy.conf;
    }

    location /v3/api-docs {
        proxy_pass http://firstpay_gateway;
        include /etc/nginx/snippets/firstpay-proxy.conf;
    }

    location /webjars {
        proxy_pass http://firstpay_gateway;
        include /etc/nginx/snippets/firstpay-proxy.conf;
    }

    # Routes du portail Angular (authGuard)
    location ~ ^/(login|home|studio|transactions|users|settings|admin_home|partners|transactions_all|audit|settings_platform|cashier|cashier_history)(/|$) {
        proxy_pass http://firstpay_frontend;
        include /etc/nginx/snippets/firstpay-proxy.conf;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    # Page payeur publique : /{shortCode}/{slug}
    location ~ ^/[A-Za-z0-9_-]+/[a-z0-9][a-z0-9_-]*/?$ {
        proxy_pass http://firstpay_payer;
        include /etc/nginx/snippets/firstpay-proxy.conf;
    }

    location = / {
        proxy_pass http://firstpay_frontend;
        include /etc/nginx/snippets/firstpay-proxy.conf;
    }

    location / {
        proxy_pass http://firstpay_frontend;
        include /etc/nginx/snippets/firstpay-proxy.conf;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

# ── HTTPS (bloc ajouté par Certbot ou activé si certificat déjà présent) ─────
# Le script setup-nginx-production.sh peut fusionner un bloc SSL via certbot --nginx.
