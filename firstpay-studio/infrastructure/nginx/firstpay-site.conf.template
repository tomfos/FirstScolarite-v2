# Cash collect First — site nginx hôte, variante HTTP seule (généré par setup-nginx-production.sh).
# Utilisée tant qu'aucun certificat Let's Encrypt n'existe pour ${DOMAIN}
# (bootstrap / émission via certbot). Dès que le certificat est présent, le script
# génère plutôt firstpay-site-ssl.conf.template (redirection 80→443 + bloc HTTPS).
# Ne pas éditer sur le serveur : modifier le template puis relancer le script.
#
# Docker (127.0.0.1) :
#   frontend       → ${NGINX_FRONTEND_PORT}  (portail admin)
#   api-gateway    → ${NGINX_GATEWAY_PORT}  (API + /public/ direct)
#   payer-frontend → ${NGINX_PAYER_PORT}     (pages payeur /{shortCode}/{slug})

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream firstpay_frontend {
    server 127.0.0.1:${NGINX_FRONTEND_PORT};
    keepalive 16;
}

upstream firstpay_gateway {
    server 127.0.0.1:${NGINX_GATEWAY_PORT};
    keepalive 16;
}

upstream firstpay_payer {
    server 127.0.0.1:${NGINX_PAYER_PORT};
    keepalive 16;
}

# ── HTTP (proxy direct — aucun certificat encore émis) ────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 (Certbot)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
    }

    include /etc/nginx/snippets/firstpay-locations.conf;
}
